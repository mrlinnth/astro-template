---
import DebugBox from "@/components/static/DebugBox.astro";
import MainLayout from "@/layouts/MainLayout.astro";
---

<MainLayout title="SSG Dynamic Routes SSG">
  <div class="breadcrumbs text-sm">
    <ul>
      <li><a class="link" href="/">Back</a></li>
    </ul>
  </div>

  <DebugBox
    path="/pages/seasons/index.astro"
    message="You need to build again for any changes in SSG (Static Site Generation). Can use in client output."
  />

  <div class="card bg-primary text-primary-content w-1/2 shadow-xl">
    <div class="card-body">
      <p>There are 4 seasons defined for SSG. Click to visit them.</p>
      <ul>
        <li><a class="link" href="/seasons/spring">/seasons/spring</a></li>
        <li><a class="link" href="/seasons/summer">/seasons/summer</a></li>
        <li><a class="link" href="/seasons/autumn">/seasons/autumn</a></li>
        <li><a class="link" href="/seasons/winter">/seasons/winter</a></li>
      </ul>

      <p>
        Visiting undefined path will result in 404 eg:
        <a class="link" href="/seasons/rain">/seasons/rain</a>
      </p>
    </div>
  </div>
</MainLayout>
