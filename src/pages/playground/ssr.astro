---
import SSRPlayground from "@/components/interactive/Playground/SSRPlayground";
import DebugBox from "@/components/static/DebugBox.astro";
import MainLayout from "@/layouts/MainLayout.astro";

const hello = Astro.url.searchParams.get("hello") || "";
---

<MainLayout title="SSR Playground">
  <DebugBox
    path="/pages/playground/ssr.astro"
    message=`Received a ${Astro.request.method} request to ${Astro.request.url}`
  />

  <div class="grid gap-4">
    <SSRPlayground hello={hello} client:only="react" />
  </div>
</MainLayout>
